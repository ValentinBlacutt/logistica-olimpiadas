{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ReverseProxy": {
        "Routes": {
            "auth-route": {
                "ClusterId": "auth-cluster",
                "Match": {
                    "Path": "/api/auth/{**catch-all}"
                }
            },
            "pedidos-route": {
                "ClusterId": "pedidos-cluster",
                "Match": {
                    "Path": "/api/pedidos/{**catch-all}"
                }
            }
        },
        "Clusters": {
            "auth-cluster": {
                "Destinations": {
                    "auth-destination": {
                        "Address": "http://authservice:8080"
                    }
                }
            },
            "pedidos-cluster": {
                "Destinations": {
                    "pedidos-destination": {
                        "Address": "http://pedidosservice:8080"
                    }
                }
            }
        }
    }
}